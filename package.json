{
  "name": "opencode-opencodex-quota",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCode V2 plugin: OpenCodex local quota in the TUI, without LLM context pollution.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "index.js",
    "tui.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc && node scripts/prepare-tui-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "validate": "npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "opencode",
    "plugin",
    "quota",
    "opencodex"
  ],
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "2.0.32",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@types/node": "^22.0.0",
    "babel-preset-solid": "1.9.12",
    "tsx": "^4.20.0",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  }
}
